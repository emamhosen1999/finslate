# FinSlate — cPanel Node.js App proxy rules
# cPanel's Node.js App manager auto-generates this file.
# If you set up the app via cPanel UI, it will be overwritten — that is fine.
# This file is a fallback for manual/Passenger-based setups.

DirectoryIndex disabled

RewriteEngine On

# Serve existing static files directly (client/dist is served by Express, not Apache).
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Forward everything else to the Node.js app.
RewriteRule ^(.*)$ http://127.0.0.1:3001/$1 [P,L]
