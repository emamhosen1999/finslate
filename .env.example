# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://finslate.aeos365.com/api/auth/google/callback

# --- MySQL (cPanel: use the DB credentials from cPanel → MySQL Databases) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpanel_username_dbuser
DB_PASSWORD=your_db_password
DB_NAME=cpanel_username_finslate

# --- Session ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_64_char_random_hex_string
NODE_ENV=production

# --- Server ---
# PORT is assigned by cPanel Node.js App manager — do NOT change this manually in cPanel env vars
PORT=3001
CLIENT_ORIGIN=https://finslate.aeos365.com

# --- Frontend (Vite) ---
# Leave EMPTY in production: client and API are served from the same origin
VITE_API_BASE_URL=
